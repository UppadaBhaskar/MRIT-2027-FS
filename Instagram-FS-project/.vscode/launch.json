{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pause on each line",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true,
            "justMyCode": true
        }
    ]
}
